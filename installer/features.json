{
  "features": {
    "core": {
      "name": "Core Application",
      "description": "Essential Mauscribe functionality including voice recording, transcription, and basic UI",
      "required": true,
      "default": true,
      "size_mb": 50,
      "files": [
        "Mauscribe.exe",
        "settings.toml",
        "src/ui/icons/icon.ico",
        "src/ui/icons/icon_idle.ico",
        "src/ui/icons/icon_record.ico",
        "src/ui/icons/icon_16.png",
        "src/ui/icons/icon_32.png",
        "src/ui/icons/icon_64.png",
        "src/ui/icons/icon_128.png",
        "src/ui/icons/icon_256.png"
      ],
      "registry_keys": [],
      "shortcuts": [
        {
          "name": "Mauscribe",
          "target": "Mauscribe.exe",
          "location": "start_menu",
          "icon": "src/ui/icons/icon.ico"
        }
      ]
    },
    "audio_database": {
      "name": "Audio Database",
      "description": "Store and manage recorded audio files with playback and retranscription capabilities",
      "required": false,
      "default": true,
      "size_mb": 10,
      "files": [
        "data/audio_database.db",
        "data/audio/"
      ],
      "registry_keys": [],
      "shortcuts": [],
      "dependencies": ["core"],
      "settings": {
        "enable_audio_files_tab": true,
        "enable_audio_database": true
      }
    },
    "enhanced_mode": {
      "name": "Enhanced Mode",
      "description": "Advanced features including better transcription quality, noise reduction, and extended language support",
      "required": false,
      "default": false,
      "size_mb": 20,
      "files": [],
      "registry_keys": [],
      "shortcuts": [],
      "dependencies": ["core"],
      "settings": {
        "enable_enhanced_mode": true
      }
    },
    "whisper_models": {
      "name": "Whisper Models",
      "description": "Download and install Whisper AI models for improved transcription accuracy",
      "required": false,
      "default": false,
      "size_mb": 1500,
      "files": [],
      "registry_keys": [],
      "shortcuts": [],
      "dependencies": ["core"],
      "download_urls": {
        "tiny": "https://huggingface.co/guillaumekln/faster-whisper-tiny/resolve/main/model.bin",
        "base": "https://huggingface.co/guillaumekln/faster-whisper-base/resolve/main/model.bin",
        "small": "https://huggingface.co/guillaumekln/faster-whisper-small.en/resolve/main/model.bin",
        "medium": "https://huggingface.co/guillaumekln/faster-whisper-medium.en/resolve/main/model.bin",
        "large": "https://huggingface.co/guillaumekln/faster-whisper-large-v2/resolve/main/model.bin"
      },
      "sizes_mb": {
        "tiny": 39,
        "base": 74,
        "small": 244,
        "medium": 769,
        "large": 1550
      },
      "descriptions": {
        "tiny": "Tiny (39 MB) - Schnellste",
        "base": "Base (74 MB) - Ausgewogen",
        "small": "Small (244 MB) - Gut",
        "medium": "Medium (769 MB) - Sehr gut",
        "large": "Large (1550 MB) - Beste Qualität"
      },
      "post_install_action": "download_models"
    },
    "autostart": {
      "name": "Start with Windows",
      "description": "Automatically start Mauscribe when Windows boots",
      "required": false,
      "default": false,
      "size_mb": 0,
      "files": [],
      "registry_keys": [
        {
          "key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
          "name": "Mauscribe",
          "value": "[INSTALLDIR]Mauscribe.exe",
          "type": "string"
        }
      ],
      "shortcuts": [],
      "dependencies": ["core"],
      "settings": {
        "auto_start_gui": true
      }
    },
    "desktop_shortcuts": {
      "name": "Desktop Shortcuts",
      "description": "Create desktop and start menu shortcuts for easy access",
      "required": false,
      "default": true,
      "size_mb": 0,
      "files": [],
      "registry_keys": [],
      "shortcuts": [
        {
          "name": "Mauscribe",
          "target": "Mauscribe.exe",
          "location": "desktop",
          "icon": "src/ui/icons/icon.ico"
        },
        {
          "name": "Mauscribe",
          "target": "Mauscribe.exe",
          "location": "start_menu",
          "icon": "src/ui/icons/icon.ico"
        }
      ],
      "dependencies": ["core"]
    },
    "ui_icons": {
      "name": "UI Icons",
      "description": "Additional UI icons for buttons and interface elements",
      "required": false,
      "default": true,
      "size_mb": 5,
      "files": [
