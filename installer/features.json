        "src/ui/icons/ui/stop_32.png",
        "src/ui/icons/ui/edit_16.png",
        "src/ui/icons/ui/edit_24.png",
        "src/ui/icons/ui/edit_32.png",
        "src/ui/icons/ui/copy_16.png",
        "src/ui/icons/ui/copy_24.png",
        "src/ui/icons/ui/copy_32.png",
        "src/ui/icons/ui/refresh_16.png",
        "src/ui/icons/ui/refresh_24.png",
        "src/ui/icons/ui/refresh_32.png",
        "src/ui/icons/ui/delete_16.png",
