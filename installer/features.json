        "src/ui/icons/ui/status_success_32.png",
        "src/ui/icons/ui/status_error_16.png",
        "src/ui/icons/ui/status_error_24.png",
        "src/ui/icons/ui/status_error_32.png",
        "src/ui/icons/ui/status_warning_16.png",
        "src/ui/icons/ui/status_warning_24.png",
        "src/ui/icons/ui/status_warning_32.png"
      ],
      "registry_keys": [],
      "shortcuts": [],
      "dependencies": ["core"]
    }
  },
  "installer": {
    "name": "Mauscribe",
    "manufacturer": "Robs",
    "upgrade_code": "{12345678-1234-1234-1234-123456789012}",
    "install_directory": "ProgramFilesFolder\\Mauscribe",
    "appdata_directory": "LocalAppDataFolder\\Mauscribe",
    "start_menu_folder": "ProgramMenuFolder\\Mauscribe",
    "desktop_folder": "DesktopFolder",
    "minimum_windows_version": "6.1",
    "supported_architectures": ["x64", "x86"]
  },
  "ui": {
    "welcome_title": "Welcome to Mauscribe Setup",
    "welcome_text": "This wizard will guide you through the installation of Mauscribe, a powerful voice-to-text application.",
    "license_file": "LICENSE",
    "feature_selection_title": "Select Features",
    "feature_selection_text": "Choose the features you want to install. You can change this selection later.",
    "installation_title": "Installing Mauscribe",
    "installation_text": "Please wait while Mauscribe is being installed.",
    "completion_title": "Installation Complete",
    "completion_text": "Mauscribe has been successfully installed on your computer.",
    "run_after_install": true,
    "show_readme": true
  },
  "uninstall": {
    "remove_appdata": true,
    "remove_registry_keys": true,
    "remove_shortcuts": true,
    "remove_start_menu": true,
    "remove_desktop_shortcuts": true,
    "remove_autostart": true,
    "confirmation_message": "Are you sure you want to completely remove Mauscribe and all of its components?"
  },
  "post_install": {
    "script": "tools/post_install.py",
    "show_welcome": true,
    "create_desktop_shortcut": true,
    "start_application": false,
    "show_readme": true
  }
}
